<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd"><THE-HEADER><REQ-IF-HEADER IDENTIFIER="HEADER_xcom-t025-sanitized"><CREATION-TIME>2026-09-26T10:12:54+00:00</CREATION-TIME><REQ-IF-TOOL-ID>fabro-engineering</REQ-IF-TOOL-ID><REQ-IF-VERSION>1.0</REQ-IF-VERSION><SOURCE-TOOL-ID>fabro-engineering</SOURCE-TOOL-ID><TITLE>xcom-t025-sanitized requirements</TITLE></REQ-IF-HEADER></THE-HEADER><CORE-CONTENT><REQ-IF-CONTENT><DATATYPES><DATATYPE-DEFINITION-STRING IDENTIFIER="DT_STRING" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="String" MAX-LENGTH="1000000" /></DATATYPES><SPEC-TYPES><SPEC-OBJECT-TYPE IDENTIFIER="TYPE_REQUIREMENT" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Requirement"><SPEC-ATTRIBUTES><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_ID" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="ID"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_Statement" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Statement"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_Revision" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Revision"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_Level" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Level"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_Status" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Status"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_Source" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Source"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_Applicability" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Applicability"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_VerificationIntent" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="VerificationIntent"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING><ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTR_AcceptanceCriteria" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="AcceptanceCriteria"><TYPE><DATATYPE-DEFINITION-STRING-REF>DT_STRING</DATATYPE-DEFINITION-STRING-REF></TYPE></ATTRIBUTE-DEFINITION-STRING></SPEC-ATTRIBUTES></SPEC-OBJECT-TYPE><SPECIFICATION-TYPE IDENTIFIER="TYPE_SPECIFICATION" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="Requirements specification" /></SPEC-TYPES><SPEC-OBJECTS><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-001" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-001"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-001"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The authority must accept a finite set of declared clock domain identities and must report an unknown or undeclared domain as a distinct deterministic failure."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (time authority identifies clock domains); interface-bridge.md; anchors: XVE-SYS-0147, FR-015&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation:: time authority public API; C++20 stdlib only."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: register and query declared domains; query an undeclared domain and assert the UnknownClock outcome with unchanged authority state."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A declared domain is accepted and addressable by identity.&#10;An undeclared domain yields a distinct UnknownClock result and no state mutation.&#10;Domain identity is stable across calls and supports equality comparison."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-002" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-002"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The authority must obtain current time for a declared domain from a host-supplied time source within a bounded, explicit interval, and must report failure distinctly when the source is unavailable or returns an out-of-bounds value."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (obtains bounded current time); interface-bridge.md; anchors: XVE-SYS-0147, FR-015&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation time authority; deterministic injectable source for tests."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: inject a deterministic source and assert domain attribution; inject failure and out-of-bounds sources and assert distinct failures."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A valid read returns a timestamp attributed to the requested domain only.&#10;A source failure or out-of-bounds value yields a distinct deterministic failure, not a guessed value.&#10;Reads never fabricate time nor silently fall back to another domain."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-003" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-003"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-003"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Converting a time from a source domain to a destination domain must require a declared mapping carrying source, destination, and maximum admissible tolerance; a missing mapping or a tolerance failure must return distinct deterministic results."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (maps between domains only under declared source, destination, and tolerance rules); interface-bridge.md; anchors: XVE-SYS-0147, FR-015&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation time authority mapping table; finite host-configurable bound."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: declared mapping inside, at, and beyond tolerance; reverse-direction request; undeclared pair; assert distinct outcomes and no mutation."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A declared mapping converts within tolerance and reports the destination domain.&#10;An undeclared source-to-destination pair yields a distinct MissingMapping result.&#10;A conversion beyond the declared tolerance yields a distinct tolerance-failure result.&#10;Mappings are directional: a declared A-to-B mapping does not silently enable B-to-A."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-004" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-004"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-004"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The authority must detect monotonic regression in a domain and arithmetic overflow during conversion, and must return distinct deterministic results for each."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (regression and overflow produce distinct deterministic results); interface-bridge.md; anchors: XVE-SYS-0147, FR-015&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation time authority; deterministic arithmetic checks."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: sequence decreasing readings; construct a boundary conversion that overflows; assert distinct codes and unchanged state."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A reading earlier than a prior reading in the same declared monotonic domain yields a distinct regression result.&#10;A conversion whose result cannot be represented yields a distinct overflow result.&#10;Regression and overflow are distinguishable from tolerance failure and from each other."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-005" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-005"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-005"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Permit-validity and session-lifecycle time decisions must be expressed as authority queries in a single domain or through a declared mapping; raw timestamps from different domains must never be compared directly."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (raw timestamps from different domains are never compared); interface-bridge.md; anchors: FR-015, FR-033, XVE-SYS-0147&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation permit validity and session lifecycle time checks."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: valid and expired permit in-domain; permit expressed in a foreign domain with and without a mapping; static check that direct cross-domain comparison is absent."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Every time-dependent decision path resolves its comparison through the authority.&#10;A permit whose validity interval is in another domain is evaluated only after a successful declared mapping, otherwise rejected with MissingMapping.&#10;No code path directly compares two raw timestamps from different domains."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-006" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-006"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-006"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The time authority must be non-copyable, must have an explicit documented lifetime, and must be safe for concurrent read/query use with deterministic results."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (define synchronization and lifetime rules, including whether the authority is non-copyable); interface-bridge.md REF-002; anchors: XVE-SYS-0147, FR-033&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation time authority ownership contract; strict Doxygen required."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit and static: non-copyability assertion; concurrent query test; strict Doxygen build for the documented ownership/lifetime/thread-safety contract."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Copy construction and copy assignment of the authority are not available.&#10;The public API documents ownership, lifetime, and thread-safety guarantees.&#10;Concurrent queries from multiple threads return deterministic results with no data race under the applicable sanitizer check."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-007" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-007"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-007"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A permit must be immutable once constructed and must bind exactly one session identity, plan digest, scenario, deployment, environment, tool, interface, target, nonce, allowed action set, validity interval, and every finite quota or capacity."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (the immutable permit binds exactly one session identity, plan digest, ... every finite quota or capacity); interface-bridge.md REF-002; anchors: XVE-SYS-0152, XVE-SYS-0144, FR-016&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation immutable permit value type; no mutator exposed."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: field-by-field mismatch matrix, one test per bound field, asserting rejection and the identified mismatching field; mutability absence asserted by API shape."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="All listed fields are present, immutable, and individually comparable; the permit exposes no mutator.&#10;A mismatch in any single field between permit and consuming session is detected and the field is identifiable.&#10;Absent or default-initialised values for an identity-bearing field are rejected and never treated as a wildcard."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-008" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-008"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-008"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The allowed action set must be a closed, finite set; undefined action bits and composite values not explicitly allowed must be rejected deterministically."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (reject undefined action bits or composite values that are not explicitly allowed); interface-bridge.md REF-002; anchors: FR-016&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation permit action-set validation."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: allowed single action; undefined bit; disallowed combination; assert distinct codes and no partial acceptance."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A permitted single action within the allowed set succeeds at validation.&#10;An undefined action bit is rejected with a distinct code.&#10;A composite or combined value not declared allowed is rejected with a distinct code and never interpreted as its components."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-009" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-009"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-009"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Consumption must be controller-scoped and exactly-once: a consumed permit identity, or a session identity already bound to a consumed permit, must not be consumed again, including when presented with a changed nonce."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (define a global or controller-scoped one-time-consumption rule; prevent duplicate exact permit or session identity from being consumed twice, including with a changed nonce); interface-bridge.md REF-002; anchors: XVE-SYS-0152, XVE-SYS-0144, FR-017&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation controller-scoped consumption bookkeeping; finite bound."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: replay matrix (same permit/same nonce, same permit/changed nonce, different session/same permit); concurrent double consumption; assert exactly one success."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="First consumption of a valid permit succeeds and records the binding atomically.&#10;Re-presenting the same permit identity is rejected, including with a different nonce.&#10;A different session identity presenting an already-consumed permit identity is rejected.&#10;Attempts to consume a permit already bound to another session identity are rejected.&#10;The declared replay scope (per controller instance) is documented and enforced."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-010" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-010"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-010"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Every finite quota or capacity bound carried by the permit and every bounded bookkeeping structure must have an explicit exhaustion result and must never exceed its bound."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (return explicit exhaustion behavior; every finite quota or capacity); interface-bridge.md REF-002; anchors: XVE-SYS-0152, FR-017&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation permit quotas and controller bookkeeping bounds; finite host-configurable."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit and boundary: capacity-1 and capacity-N boundaries for quotas and for session/permit tables; assert last-success and first-exhaustion results."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Consuming at the final available unit succeeds; one beyond yields a distinct exhaustion result.&#10;Exhaustion does not consume, partially apply, or mutate unrelated state.&#10;Bookkeeping structures never grow past their configured bound."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-011" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-011"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-011"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A session handle must bind a host-generated controller identity and a generation counter so that stale, foreign, and recreated-controller handles cannot authorise any operation."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (session handles bind a host-generated controller identity and generation so stale, foreign, and recreated-controller handles cannot authorize a record); interface-bridge.md REF-002; anchors: XVE-SYS-0144, XVE-SYS-0152, FR-018&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation session handle and controller identity types."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: ownership and recreation matrix with stale, foreign, and forged handles; assert rejection, no mutation, and no effect on any other live session."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A valid current handle from the owning controller is accepted.&#10;A stale handle (prior generation) is rejected distinctly.&#10;A foreign handle (different controller identity) is rejected distinctly.&#10;A handle from a recreated controller with the same name but a new identity is rejected.&#10;Handle forgery never addresses a live session."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-012" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-012"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-012"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The lifecycle must expose declared to armed to active to closing to closed, with expired, revoked, and evidence-incomplete as terminal states, and must define which transitions are legal from each state."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (the lifecycle exposes declared, armed, active, closing, closed; expired, revoked, and evidence-incomplete are terminal); interface-bridge.md REF-002; anchors: XVE-SYS-0152, FR-018&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation session state machine."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: full transition table (legal and illegal pairs); terminal-state lockout; assert resulting state values and rejection codes."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Each state is reachable via its defined operation from its predecessor.&#10;Terminal states admit no outgoing transition and attempts are rejected deterministically.&#10;Invalid transitions such as declared to active are rejected without mutation.&#10;Expiry and revocation can be applied from the states where they are legal."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-013" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-013"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-013"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Validation of handle, context, time, and action must complete before any state mutation; safe idempotent repeats must be accepted with a stable already-applied outcome and unsafe repeats must be rejected."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (define safe idempotency, reject unsafe repeats, and ensure validation of handle, context, time, and action precedes any state mutation); interface-bridge.md REF-002; anchors: XVE-SYS-0144, FR-019&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation session transition operations."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: each pre-mutation validation stage injected in turn with a state snapshot comparison; safe-repeat and unsafe-repeat cases for each transition."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="No state change is observable when any pre-mutation validation fails.&#10;A safe repeat (already in the requested state with the same owning handle) returns a stable already-applied outcome without changing state.&#10;An unsafe repeat conflicting with current state is rejected distinctly.&#10;The set of safe repeats is explicitly enumerated in the design."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-014" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-014"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-014"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Live session capacity and controller/handle bookkeeping must be finite and host-configurable; creation beyond capacity must fail explicitly without leaking a handle."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (finite quotas or capacities; bounded session lifecycle); interface-bridge.md REF-002; anchors: XVE-SYS-0147, FR-033&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation session table and slot accounting; finite host-configurable bound."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit and boundary: fill to capacity, attempt overflow, close one, reuse; assert results, handle invalidity, and slot accounting."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Creating sessions up to capacity succeeds; one beyond yields an explicit capacity result.&#10;A failed creation returns no usable handle and leaves capacity unchanged.&#10;Closing or terminating a session frees exactly its capacity slot, allowing reuse."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-015" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-015"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-015"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Every rejected operation must leave the affected session record, permit consumption bookkeeping, counters, and authority state unchanged."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (rejected operations leave state unchanged); interface-bridge.md REF-002; anchors: XVE-SYS-0154, FR-019&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation all rejecting operations."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: snapshot-before/after assertions for every negative case in the mismatch, replay, clock, handle, and lifecycle matrices."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="For each negative case a snapshot-equality assertion covers state, consumed set, and counters.&#10;Rejection on one session does not perturb any other session or the authority.&#10;A failed transition never partially applies and exposes no intermediate state."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-016" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-016"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-016"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Diagnostics must be returned as an ordered sequence of stable, enumerable codes with no payload, item, observation, or free-form content, and multi-failure ordering must follow a declared precedence."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (produce stable, ordered, payload-free diagnostics); interface-bridge.md REF-002; anchors: XVE-SYS-0154, FR-020&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation public diagnostic result type."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit: precedence cases with an expected exact code sequence; repeat determinism; structural assertion that diagnostic types hold no payload."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A diagnostic value is a bounded enumerable code, optionally with a bounded numeric locator, and carries no data string.&#10;Multi-failure inputs produce the declared precedence order, identical on repetition.&#10;The same input yields the same code sequence across runs and builds.&#10;No diagnostic can carry a communication item, observation, or payload."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-017" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-017"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-017"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Concurrent permit consumption and concurrent session mutation must be atomic with respect to shared state, producing deterministic outcomes with exactly one success where the operation is exactly-once."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (explicit time authority; deterministic concurrency; synchronization rules); interface-bridge.md REF-002; anchors: XVE-SYS-0147, FR-033&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation shared controller and consumption state."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Unit and integration: multithreaded consumption and lifecycle stress with an exact success-count assertion and sanitizer execution."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="N concurrent consumptions of one valid permit yield exactly one success.&#10;The remaining N-minus-1 outcomes are drawn from the defined non-success set with no duplicate applied mutation.&#10;Shared mutable state is guarded so no data race is reported under the applicable sanitizer run."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-SR-018" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-SR-018"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-SR-018"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The candidate must not expose or perform any normal-route emission: no communication item, transport, gateway, network listener, journal, lease, dashboard, persistent store, or external service, and no logging or telemetry in the nominal path."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="software"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet&quot;, &quot;reference&quot;: &quot;packet.md (the foundation must neither emit a communication item nor create a transport, gateway, network listener, journal, lease, dashboard, persistent store, or external service; all normal-route emission counts remain zero); anchors: FR-020&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="xverse::xcom::validation public API surface and nominal execution path."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Static: API-surface enumeration and I/O-call inspection. Unit and integration: nominal scenario asserting a zero emission counter and absence of emission side effects."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The public API surface contains no emission, transport, or persistence entry point.&#10;Nominal operations perform no file, socket, or environment I/O.&#10;A reported normal-route emission counter is zero after the nominal test scenario."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-STK-001" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-STK-001"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-STK-001"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="All permit-validity and session-lifecycle time decisions must be made through a single explicit time authority that knows its clock domains and only compares times within one domain or through a declared mapping."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="stakeholder"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (time-authority clause); interface-bridge.md; anchors: XVE-SYS-0147, FR-015, FR-033&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="T025 standalone candidate: xverse::xcom::validation, C++20 standard library only; foundation slice, no stimulation."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Preserve as the top-level intent refined by T025-SR-001..T025-SR-005; verified through their unit and static checks."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="AC-1: No code path compares a raw timestamp from one clock domain with a raw timestamp from a different clock domain.&#10;AC-2: An unrecognised clock domain yields a distinct deterministic result rather than silent success.&#10;AC-3: A cross-domain comparison without a declared mapping yields a distinct deterministic result rather than silent success.&#10;AC-4: Unknown clock, missing mapping, tolerance failure, regression, and overflow are each distinguishable by result value."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-STK-002" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-STK-002"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-STK-002"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A host-controlled local validation permit must bind exactly one session and its complete operational envelope, and must be consumed at most once."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="stakeholder"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (immutable permit / one-time consumption clause); interface-bridge.md REF-002; anchors: XVE-SYS-0152, XVE-SYS-0144, FR-016, FR-017&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="T025 standalone candidate; local prototype permit control only, general channel identity/access deferred to Security."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Refined by T025-SR-007..T025-SR-010 and verified by the permit mismatch, replay, action-set, and exhaustion matrices."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="AC-1: A permit differing from the consuming session in any single bound field is rejected and the mismatching field is identifiable from the diagnostic.&#10;AC-2: A consumed permit cannot be consumed again, including when presented with a changed nonce.&#10;AC-3: A second session identity cannot consume a permit already consumed for another session.&#10;AC-4: Undefined action bits and composite values not explicitly allowed are rejected.&#10;AC-5: Exhausted finite quotas or capacities produce an explicit exhaustion result."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-STK-003" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-STK-003"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-STK-003"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="A validation session is created by a host-generated controller identity, is addressed by a handle bound to that controller identity and a generation, and moves only through the defined lifecycle and terminal states."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="stakeholder"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (session handle / lifecycle clause); interface-bridge.md REF-002; anchors: XVE-SYS-0144, XVE-SYS-0152, FR-018&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="T025 standalone candidate; bounded lifecycle foundation only, stimulation and Maestro triggers deferred."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Refined by T025-SR-011..T025-SR-013 and verified by the ownership/recreation, transition-table, and ordering tests."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="AC-1: Every lifecycle state declared, armed, active, closing, closed, expired, revoked, evidence-incomplete is reachable through defined operations.&#10;AC-2: A stale handle, a foreign handle, and a handle from a recreated controller cannot authorise an operation on another live session.&#10;AC-3: An unsafe repeat of an already-completed lifecycle operation is rejected deterministically.&#10;AC-4: Validation of handle, context, time, and action completes before any state mutation."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-STK-004" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-STK-004"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-STK-004"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Any rejected operation leaves the affected session and permit state unchanged and produces a stable, ordered diagnostic that carries no payload."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="stakeholder"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (rejection / diagnostics clause); interface-bridge.md REF-002; anchors: XVE-SYS-0154, FR-019, FR-020&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="T025 standalone candidate; payload-free diagnostic foundation, durable intent/outcome provenance deferred."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Refined by T025-SR-015 and T025-SR-016 and verified by snapshot-equality and diagnostic-precedence tests."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="AC-1: For every negative case, observable session state, permit consumption state, and counters are identical before and after the rejected call.&#10;AC-2: Repeating an identical rejected call produces an identical diagnostic code sequence.&#10;AC-3: When more than one failure applies, the reported code follows the declared precedence order deterministically.&#10;AC-4: No diagnostic contains a payload, item, observation, or free-form content field."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-STK-005" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-STK-005"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-STK-005"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The normal route must emit zero communication items, zero telemetry, zero network traffic, and zero persisted records."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="stakeholder"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet&quot;, &quot;reference&quot;: &quot;packet.md (no emission / no transport clause); anchors: FR-020&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="T025 standalone candidate; emission-free foundation, no transport, gateway, listener, journal, lease, dashboard, persistent store, or external service."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Refined by T025-SR-018 and verified by API-surface static checks plus a nominal-scenario zero-emission counter assertion."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="AC-1: The candidate exposes no emission, transport, journal, or persistence API.&#10;AC-2: Nominal (non-test) execution performs no I/O beyond in-memory state.&#10;AC-3: Any normal-route emission counter reported by the candidate is zero."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT><SPEC-OBJECT IDENTIFIER="REQ_T025-STK-006" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="T025-STK-006"><VALUES><ATTRIBUTE-VALUE-STRING THE-VALUE="T025-STK-006"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="The foundation's memory, permit bookkeeping, and session capacity are finite and configurable, and concurrent use yields deterministic results without duplicate consumption."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Statement</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Revision</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="stakeholder"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Level</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="accepted"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Status</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="{&quot;kind&quot;: &quot;admitted_packet_and_bridge&quot;, &quot;reference&quot;: &quot;packet.md (synchronization and lifetime clause); interface-bridge.md REF-002; anchors: XVE-SYS-0147, FR-033&quot;}"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Source</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="T025 standalone candidate; finite host-configurable bounds with no invented numeric reliability target."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_Applicability</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="Refined by T025-SR-006, T025-SR-010, T025-SR-014, T025-SR-017 and verified by boundary and concurrent stress tests."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_VerificationIntent</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING><ATTRIBUTE-VALUE-STRING THE-VALUE="AC-1: Session capacity, permit-consumption bookkeeping, and mapping tables have finite, host-configurable bounds with defined exhaustion behaviour.&#10;AC-2: Concurrent attempts to consume the same permit produce exactly one success and a deterministic set of failures.&#10;AC-3: Concurrent session operations do not corrupt handle/controller binding or lifecycle state.&#10;AC-4: Time-authority lifetime and copy/synchronisation rules are explicit and honoured."><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ATTR_AcceptanceCriteria</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING></VALUES><TYPE><SPEC-OBJECT-TYPE-REF>TYPE_REQUIREMENT</SPEC-OBJECT-TYPE-REF></TYPE></SPEC-OBJECT></SPEC-OBJECTS><SPECIFICATIONS><SPECIFICATION IDENTIFIER="SPEC_xcom-t025-sanitized" LAST-CHANGE="2026-09-26T10:12:54+00:00" LONG-NAME="xcom-t025-sanitized requirements"><CHILDREN><SPEC-HIERARCHY IDENTIFIER="HIER_T025-SR-001" LAST-CHANGE="2026-09-26T10:12:54+00:00"><OBJECT><SPEC-OBJECT-REF>REQ_T025-SR-001</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY><SPEC-HIERARCHY IDENTIFIER="HIER_T025-SR-002" LAST-CHANGE="2026-09-26T10:12:54+00:00"><OBJECT><SPEC-OBJECT-REF>REQ_T025-SR-002</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY><SPEC-HIERARCHY IDENTIFIER="HIER_T025-SR-003" LAST-CHANGE="2026-09-26T10:12:54+00:00"><OBJECT><SPEC-OBJECT-REF>REQ_T025-SR-003</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY><SPEC-HIERARCHY IDENTIFIER="HIER_T025-SR-004" LAST-CHANGE="2026-09-26T10:12:54+00:00"><OBJECT><SPEC-OBJECT-REF>REQ_T025-SR-004</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY><SPEC-HIERARCHY IDENTIFIER="HIER_T025-SR-005" LAST-CHANGE="2026-09-26T10:12:54+00:00"><OBJECT><SPEC-OBJECT-REF>REQ_T025-SR-005</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY><SPEC-HIERARCHY IDENTIFIER="HIER_T025-SR-006" LAST-CHANGE="2026-09-26T10:12:54+00:00"><OBJECT><SPEC-OBJECT-REF>REQ_T025-SR-006</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY><SPEC-HIERARCHY IDENTIFIER="HIER_T025-SR-007" LAST-CHANGE="2026-09-26T10:12:54+00: