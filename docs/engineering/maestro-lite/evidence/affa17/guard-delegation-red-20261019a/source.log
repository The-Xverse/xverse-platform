            if frame.kind is K.ARM and frame.slot==sink.slot and mode=='parent-dies-after-arm':
                signal.pidfd_send_signal(capability.fileno(),signal.SIGKILL)
                assert select.select([capability.fileno()],[],[],.5)[0]
