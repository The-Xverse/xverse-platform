{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "maturity": "DRAFT",
  "verification_executed": false,
  "title": "Draft independent Maestro lifecycle coverage report v2.0",
  "description": "Successor coverage report version. v1 is preserved unchanged. v2.0 separates the provisional pre-closure assessment from the authoritative offline assessment, splits mandatory normal-record status from emergency-fact status, and excludes the report by an explicit relative path (the accepted record_artifact index is path-keyed and emits no artifact ID).",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "lifecycleDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "assessmentStage": { "enum": ["pre-closure", "offline-post-closure"] },
    "eventScope": { "const": "maestro-lifecycle-before-writer-closure" },
    "admittedTemplatesDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "expectedObligationsDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "trustBoundary": { "type": "string", "minLength": 1, "maxLength": 512 },
    "retainedInputsDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "rows": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "required": [
          "obligationId", "obligationClass", "unitId", "generation", "operationId",
          "required", "applicable", "status", "evidenceIds", "diagnostic"
        ],
        "properties": {
          "obligationId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "obligationClass": {
            "enum": ["normal-record", "emergency-fact", "artifact", "step-disposition", "unit-disposition"]
          },
          "unitId": { "type": ["string", "null"] },
          "generation": { "type": "integer", "minimum": 0 },
          "operationId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "required": { "type": "boolean" },
          "applicable": { "type": ["boolean", "null"] },
          "status": {
            "enum": ["satisfied", "not-applicable", "missing", "conflicting", "unverifiable"]
          },
          "evidenceIds": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "diagnostic": { "type": ["string", "null"], "maxLength": 256 }
        },
        "additionalProperties": false
      }
    },
    "normalRecordStatus": { "enum": ["complete", "incomplete", "unverifiable"] },
    "emergencyFactStatus": { "enum": ["complete", "incomplete", "unverifiable", "not-needed"] },
    "overallStatus": { "enum": ["complete", "incomplete", "unverifiable"] },
    "excludedWriterKinds": { "const": ["run-opened", "run-closed", "run-failed"] },
    "excludedReportRelativePath": { "type": "string", "minLength": 1, "maxLength": 256 },
    "inputDigests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    }
  },
  "required": [
    "schemaVersion", "lifecycleDigest", "runId", "assessmentStage", "eventScope",
    "admittedTemplatesDigest", "expectedObligationsDigest", "trustBoundary", "rows",
    "normalRecordStatus", "emergencyFactStatus", "overallStatus", "excludedWriterKinds",
    "excludedReportRelativePath", "inputDigests"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "assessmentStage": { "const": "pre-closure" } }, "required": ["assessmentStage"] },
      "then": {
        "properties": {
          "overallStatus": { "const": "incomplete" }
        }
      }
    }
  ]
}
